{
  "name": "@hyperion/evm",
  "private": true,
  "version": "0.1.0",
  "description": "Hyperion's EVM side: the router, the rail adapters, and the libraries they share",
  "license": "MIT",
  "scripts": {
    "build": "node init && forge build",
    "test": "forge test",
    "test:ci": "FOUNDRY_PROFILE=ci forge test",
    "gas": "forge test --gas-report",
    "coverage": "forge coverage --ir-minimum",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "lint:src": "solhint -c .solhint.json --max-warnings 0 \"src/*.sol\" \"src/adapters/*.sol\" \"src/libraries/*.sol\"",
    "lint:interfaces": "solhint -c .solhint.interfaces.json --max-warnings 0 \"src/interfaces/*.sol\"",
    "lint:tests": "solhint -c .solhint.tests.json --max-warnings 0 \"test/**/*.sol\"",
    "lint": "npm run lint:src && npm run lint:interfaces && npm run lint:tests",
    "check": "npm run fmt:check && npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "solhint": "6.2.4"
  }
}
