# Rust / Soroban
target/
**/target/
*.wasm
!deployments/**/*.wasm.sha256
# Regenerated on every `cargo test` run. Eight megabytes of ledger JSON that says nothing a
# reviewer needs and conflicts on every branch.
test_snapshots/

# Foundry
evm/out/
evm/cache/
evm/broadcast/
# `evm/lib` is deliberately NOT ignored. forge-std and OpenZeppelin live there as pinned git
# submodules, so a contributor who clones gets the exact revision the suite was run against
# rather than whatever a registry resolves to on the day.
evm/.gas-snapshot.tmp

# Node
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/

# Secrets. Nothing in here ever reaches a commit.
.env
.env.*
!.env.example
*.pem
*.key
!**/*.key.example
secrets/
.secrets
keystore/
*.keystore
.stellar/
.soroban/
deployer.json
signer.json
*.mnemonic
*.seed

